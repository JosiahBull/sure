# Rust
/target
**/*.rs.bk
*.pdb

# Node
node_modules
.pnpm-store
dist
dist-ssr
*.local
.vite

# SQLite databases (dev + test artifacts)
*.db
*.db-shm
*.db-wal
/data

# Generated OpenAPI artifact (regenerated from the backend)
/packages/client/openapi.json

# Playwright (keep committed snapshot baselines under tests/*-snapshots/)
/packages/web/test-results
/packages/web/playwright-report
/packages/web/blob-report
/packages/web/.playwright
/packages/web/tests/.server.pid
# The proxy global-setup spawns beside that backend. Both files are removed on teardown, so one
# surviving means a run died before it — which is exactly when someone is about to `git add -A`.
/packages/web/tests/.proxy.pid
/packages/api-tests/test-results
/.playwright-mcp

# Personal Sharesies data exports (see scripts/fetch-sharesies-data.sh) — real portfolio data,
# never publish this
/sharesies-export/
/sharesies-export-*/
/sharesies-instruments-*/

# Personal myIR student-loan exports (see docs/STUDENT-LOAN.md) — real transaction history,
# never publish this
/myir-export/

# Exports from asb.
asb-export/

# Recorded Akahu traffic (see scripts/pii-scan.mjs) — real account numbers, balances and
# transaction memos, never publish this. The reason this is not merely theoretical: Frankfurter
# and Yahoo recordings *are* committed, in packages/providers/tests/snapshots/, being public
# market data — so a recorder already exists and is one `Upstream` away from writing a third
# file. This rule plus pii-scan's are what keep that one local rather than making it a decision
# someone has to remember. An Akahu fixture that lands is hand-authored with invented
# identifiers, so nothing legitimate ever arrives in this directory.
/packages/api-tests/snapshots/akahu/

# Env / editor
.env
.env.*
!.env.example
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
