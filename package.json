{
  "name": "sure",
  "version": "0.1.0",
  "private": true,
  "description": "Sure — a fast, local financial tracker (Rust + Axum + SQLite backend, Svelte SPA frontend).",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta --kill-others-on-fail \"pnpm dev:api\" \"node scripts/wait-for-backend.mjs && pnpm dev:web\"",
    "clean": "bash scripts/clean.sh",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:api:once": "cargo run -p sure-server --bin sure-api",
    "dev:api:blocked": "node scripts/blocked.mjs node scripts/dev-api.mjs",
    "dev:web": "pnpm --filter @sure/web dev",
    "build": "pnpm gen:client && cargo build --release && pnpm --filter @sure/web build",
    "gen:openapi": "cargo run -p sure-api --bin gen-openapi -- packages/client/openapi.json",
    "gen:client": "pnpm gen:openapi && pnpm --filter @sure/client generate",
    "test": "pnpm test:rust && pnpm test:api && pnpm test:web",
    "test:rust": "cargo test --workspace --all-features",
    "test:api": "pnpm --filter @sure/api-tests test",
    "test:api:blocked": "node scripts/blocked.mjs pnpm --filter @sure/api-tests test --workers=1",
    "test:api:check": "pnpm --filter @sure/api-tests check",
    "test:web": "pnpm --filter @sure/web test",
    "test:web:install": "pnpm --filter @sure/web exec playwright install chromium",
    "seed": "node scripts/seed.mjs",
    "fixtures:record": "cargo test -p sure-providers --test recorded_upstreams -- --ignored --nocapture",
    "lint:rust": "cargo clippy --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --all",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
