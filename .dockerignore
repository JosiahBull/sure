# Keep the Docker build context small and reproducible. Everything the image needs is
# rebuilt inside it, so build outputs, deps, and local artifacts are excluded — the
# Dockerfile COPYs the specific source paths it wants.
**/target
**/node_modules
**/dist
**/dist-ssr
.git
.github
docs
scripts/*.mjs

# Personal data exports (the same set .gitignore excludes) — real portfolio, student-loan and
# bank-statement history. Every COPY below is path-specific, so these never reached an image, but
# they have no business being uploaded to the daemon as build context either.
/sharesies-export
/sharesies-export-*
/sharesies-instruments-*
/myir-export
/asb-export

# Local databases and test/build artifacts
/data
**/*.db
**/*.db-shm
**/*.db-wal
**/test-results
**/playwright-report
**/blob-report
**/.playwright
**/.playwright-mcp
**/.server.pid

# Generated (regenerated inside the image from the backend)
packages/client/openapi.json

# NOT ignored, and deliberately: `.sqlx` (compile-time query metadata) and `.cargo/config.toml`
# (which pins SQLX_OFFLINE=true) are COPYd by both Rust stages of packages/api/Dockerfile. They
# are what let the image compile with no database at all — excluding them breaks the build.

# Editor / OS cruft and loose images
**/.DS_Store
.idea
.vscode
*.png
*.local
.env
.env.*
