#!/usr/bin/env bash
#
# Pre-commit checks for the sure repo. Mirrors the deterministic gates in
# .github/workflows/checks.yml so most failures are caught before they reach CI.
#
# ONE JOB PER REQUIRED CONTEXT, and the mapping is written out so a gap is visible rather than
# inferred. `main`'s branch protection requires ten contexts; this hook covers nine of them:
#
#   checks / Personal-data scan     → scripts/pii-scan.mjs
#   checks / Dependabot config      → scripts/check-dependabot.sh
#   checks / Versions               → scripts/check-versions.sh
#   checks / sqlx offline metadata  → scripts/sqlx-prepare.mjs --check
#   checks / Rustfmt                → cargo fmt --all --check
#   checks / Clippy                 → cargo clippy … -D warnings
#   checks / Cargo tests            → cargo test --workspace --all-features
#   checks / API e2e tests          → pnpm test:api
#   checks / Typecheck              → BOTH `--filter @sure/web check` and
#                                     `--filter @sure/api-tests check` (the CI job runs both)
#   checks / Web visual tests       → deliberately absent; see the note below
#
# Adding a required context without adding it here is the failure this table exists to make
# obvious. Three of the rows above were missing at once — `Versions`, `Dependabot config`, and
# the api-tests half of `Typecheck` — so a commit could pass every gate a person had been told
# to run and still be blocked by CI, which is how a broken `.github/dependabot.yml` reached
# main on 2026-08-16.
#
# Corollary worth stating, because it is how that one was missed *twice*: run the gates, or run
# this hook — do not hand-run a subset and read the tail of it. `./scripts/check-dependabot.sh
# | tail -2` printed the one passing line while the failing one scrolled past, and the exit code
# went unread. Every command below runs under `set -e`, which is the point of running them here.
#
# The scan goes first because it costs milliseconds and guards something a later
# gate cannot undo — see CLAUDE.md rule 3, and `node scripts/pii-scan.mjs --all` to sweep the
# whole tree rather than staged additions. `cargo test` sits directly after clippy: clippy has
# already compiled the workspace by then, so the marginal cost is linking and running the test
# binaries, and a type error is reported by the cheaper gate first rather than surfacing
# as a confusing test-compile failure.
#
# The sqlx check comes before rustfmt/clippy for a specific reason: every query in the DAL is
# compile-time checked against the committed `.sqlx/` metadata, so if that metadata is stale,
# clippy and `cargo test` both fail with a confusing *query* error rather than saying what is
# actually wrong. Running it first turns "you edited a query and didn't re-run
# `pnpm sqlx:prepare`" into its own message. It also rebuilds the throwaway schema database
# under `target/`, never `data/sure.db` — see scripts/sqlx-prepare.mjs.
#
# Deliberately does NOT run the web *visual* suite (`pnpm test:web`): those
# screenshot tests are only deterministic inside the pinned Playwright container CI uses
# (see the `web-tests` job in checks.yml), and a run of them costs minutes. Regenerate their
# `-linux.png` baselines with `pnpm snapshots:update`, which runs that same container locally
# (scripts/linux-snapshots.mjs), never from a bare local `playwright test --update-snapshots`.
#
# Bypass in an emergency with `git commit --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

run() {
  echo "▶ $*"
  "$@"
}

run node scripts/pii-scan.mjs
# Both cost about a second, and both guard a file a person edits by hand and cannot easily
# check by eye: the 0.x ignore list (which a new dependency silently invalidates) and the two
# version strings that have to agree. Up here with the scan for the same reason — cheapest
# first, so a trivially-fixable mistake is not reported after ten minutes of compiling.
run ./scripts/check-dependabot.sh
run ./scripts/check-versions.sh
run node scripts/sqlx-prepare.mjs --check
run cargo fmt --all --check
run cargo clippy --workspace --all-targets --all-features -- -D warnings
# Feature set mirrors clippy's so feature-gated tests are compiled; no --all-targets,
# which for `cargo test` would drop the doctests. See the `test` job in checks.yml.
run cargo test --workspace --all-features
run pnpm test:api
# Both halves, because the `Typecheck` job runs both — and they check different things: the web
# one is svelte-check over the SPA plus `tsc` over packages/web/tests, the api-tests one is `tsc`
# over the backend e2e suite. Running only the first is how a spec that no longer compiles
# against a regenerated client reaches CI.
run pnpm --filter @sure/web check
run pnpm --filter @sure/api-tests check

echo "✓ pre-commit checks passed (9 of main's 10 required contexts; visual suite is CI-only)"
