# Copy to `.env` (gitignored) and fill in. The backend loads it automatically on startup,
# searching the working directory and its parents — so `pnpm dev`, `cargo run`, and
# `./target/release/sure-api` all pick up this file from anywhere in the repo.
#
# Anything already exported in the real environment wins over this file. Point
# SURE_ENV_FILE at another path to load that instead, or set it empty to load nothing.

# --- Akahu (NZ bank feeds) -------------------------------------------------------------
# From your Akahu personal-app dashboard. Without them "akahu" still appears as a provider
# kind, but discovery and sync fail naming the missing var.
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=

# --- Sharesies (scripts/fetch-sharesies-data.sh) ---------------------------------------
# Only used by that script, not by the server. The cookie is a live session for whoever
# holds it — treat it like a password.
SHARESIES_COOKIE=
SHARESIES_ACCOUNT_ID=
SHARESIES_WALLET_ID=

# --- Server ----------------------------------------------------------------------------
# Every one of these has a working default; uncomment only what you want to change.
# DATABASE_URL=sqlite:data/sure.db
# BIND_ADDR=127.0.0.1:8080
# WEB_DIR=packages/web/dist    # serve the built SPA from the same origin as the API
# RUST_LOG=info
# BACKGROUND_TASKS=on          # off = no exchange-rate/provider/stock-price/linking tasks

# Log colour. Off by default, deliberately: logs are normally read back through `docker logs`,
# `journalctl`, or a TrueNAS app's log pane, none of which interpret ANSI — so every line would
# arrive full of `ESC[2m`. `auto` colours only when stdout is a terminal; `always` colours
# regardless, for a pager or a CI viewer that renders it out of a pipe. An unrecognised value
# warns once and stays plain.
# SURE_COLOR=never             # never | auto | always

# Caching, compression, CORS, and the abuse guards are tuned by their own vars — the
# defaults are the intended settings. See docs/HTTP.md for the full list.
# CORS_ALLOWED_ORIGINS=https://sure.example.com

# --- MCP (agent access) ------------------------------------------------------------------
# Off by default, and worth leaving off unless you want it: enabling this sends transaction
# descriptions — which carry account numbers, payee names and card last-fours — to whichever
# model the connecting client runs.
#
# This is a CEILING, not the working mode. The mode itself lives in the app (Settings →
# Preferences → Agent access) and is clamped to this, so leaving this unset means no setting
# in the app can turn anything on — enabling agent access needs access to the host, not just
# to the app. An unrecognised value stops the server rather than guessing which you meant.
# See docs/MCP.md.
# SURE_MCP=read                # off | read | write — the most the app may choose
# SURE_MCP_MAX_ROWS=200        # ceiling on rows any one tool returns

# --- Provider endpoints ----------------------------------------------------------------
# Where each outbound integration points. The defaults below are the real APIs and are
# what production runs; they are settable so a test can aim the app at the local
# record/replay proxy (`sure-testproxy` prints exactly these three vars, with an ephemeral
# port each) instead of the live services.
#
# Unlike the tunables above, a value that won't parse stops startup rather than falling back
# to the default: a silent fallback would mean talking to a different host than you asked
# for. `http://` is refused outright unless the host is this machine, so a typo can't put
# the Akahu app token on the wire in the clear.
#
# On Linux the sandbox only permits outbound 443, so a proxy on any other port also needs
# SURE_SANDBOX_CONNECT_PORTS (below) to list it.
# FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
# YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart
# AKAHU_BASE_URL=https://api.akahu.io/v1

# --- How hard to lean on those three -----------------------------------------------------
# Rate limits at these upstreams are enforced on the *household*, not on this app, so a burst
# costs the one person whose data it is. Tunables again, so a wrong value warns and falls back.
# Any of them at 0 turns that guard off. See docs/HTTP.md for what each one guards.
# PROVIDER_MIN_REQUEST_INTERVAL_MS=500  # floor on the gap between two requests to one host,
#                                       #   including between the pages of an Akahu sweep
# PROVIDER_MAX_BACKOFF_SECS=300         # longest Retry-After honoured after a 429, so an
#                                       #   upstream can't disable an integration by saying so
# PROVIDER_DISCOVERY_TTL_SECS=60        # reuse of an Akahu account listing, and of Yahoo's
#                                       #   404 for a symbol that doesn't exist
# PROVIDER_SYNC_COOLDOWN_SECS=60        # gap between real syncs of one provider. Inside it,
#                                       #   POST /api/providers/{id}/sync answers 200 with the
#                                       #   previous run and fresh:false instead of sweeping.
#                                       #   Only successful syncs start it; a failed one can be
#                                       #   retried at once.

# --- Landlock sandbox (Linux only) -------------------------------------------------------
# The server drops every ambient right it doesn't need before it opens the database. On by
# default and a no-op elsewhere; see docs/SANDBOX.md for the policy it applies.
# SURE_SANDBOX=best-effort            # off | best-effort | enforce (enforce = don't start
#                                     #   unless the whole policy is in force)
# SURE_SANDBOX_READ_PATHS=/srv/extra  # extra read-only paths, ':'-separated
# SURE_SANDBOX_WRITE_PATHS=/srv/out   # extra read-write paths, ':'-separated
# SURE_SANDBOX_CONNECT_PORTS=8081     # extra outbound TCP ports, ','-separated
